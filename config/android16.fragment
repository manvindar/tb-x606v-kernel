# Applied on top of achilles6_row_call_defconfig (merge_config.sh).
# Android 16 userspace (netd/eBPF loader) uses these. PSI is 4.20+, so lmkd keeps its vmpressure path.
CONFIG_BPF_JIT=y
CONFIG_NET_ACT_BPF=y
CONFIG_BPF_EVENTS=y
CONFIG_CGROUP_BPF=y
# fiq_cache_init dereferences a NULL AEE record on this source drop (crash at 0.59 s). Debug-only crash-dump helper.
# CONFIG_MTK_FIQ_CACHE is not set
